{
    "name": "panas",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "dev": "pnpm --filter @panas/web dev",
        "build": "turbo run build",
        "typecheck": "turbo run typecheck && pnpm platform:typecheck && tsc -p scripts/release/tsconfig.json --noEmit && tsc -p scripts/payments/tsconfig.json --noEmit",
        "lint": "eslint . --max-warnings 0",
        "test": "vitest run",
        "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "provider:doctor": "pnpm --filter @panas/provider run doctor",
        "platform:migrate": "tsx scripts/platform/migrate.ts",
        "platform:bundle": "tsx scripts/platform/bundle.ts",
        "platform:deploy": "tsx scripts/platform/deploy.ts",
        "platform:verify": "tsx scripts/platform/verify.ts",
        "platform:typecheck": "tsc -p scripts/platform/tsconfig.json --noEmit",
        "release:bundle": "tsx scripts/release/bundle.ts",
        "release:pack": "tsx scripts/release/pack.ts",
        "release:smoke": "tsx scripts/release/smoke.ts && tsx scripts/release/install-smoke.ts",
        "test:accounting-db": "node scripts/test-accounting-database.mjs && vitest run packages/accounting/src/accounting.test.ts",
        "treasury:create": "tsx scripts/payments/treasury.ts"
    },
    "devDependencies": {
        "@modelcontextprotocol/sdk": "1.32.2",
        "@panas/contracts": "workspace:*",
        "@panas/eslint-config": "workspace:*",
        "@panas/typescript-config": "workspace:*",
        "@solana-program/token": "0.18.0",
        "@solana/kit": "8.6.0",
        "@types/node": "24.19.2",
        "@types/pg": "8.23.1",
        "@volcano.dev/cli": "0.55.0",
        "esbuild": "0.28.2",
        "eslint": "10.13.0",
        "pg": "8.23.1",
        "prettier": "3.9.10",
        "tsx": "4.23.15",
        "turbo": "2.11.10",
        "typescript": "6.0.3",
        "vitest": "5.0.5",
        "wrangler": "4.156.0"
    },
    "type": "module"
}
