{
    "name": "panas",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "dev": "pnpm --filter @panas/web dev",
        "build": "turbo run build",
        "typecheck": "turbo run typecheck",
        "lint": "eslint . --max-warnings 0",
        "test": "vitest run",
        "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "provider:doctor": "pnpm --filter @panas/provider run doctor"
    },
    "devDependencies": {
        "@panas/eslint-config": "workspace:*",
        "@panas/typescript-config": "workspace:*",
        "@types/node": "24.19.2",
        "eslint": "10.13.0",
        "prettier": "3.9.10",
        "turbo": "2.11.10",
        "typescript": "6.0.3",
        "vitest": "5.0.5",
        "tsx": "4.23.15"
    },
    "type": "module"
}
